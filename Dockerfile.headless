# Build the headless (GTK/WebKit-free) Linux binary for Rocky/RHEL 9.
# Usage:
#   docker build -t llm-wiki-headless -f Dockerfile.headless .
#   docker create --name lwtmp llm-wiki-headless
#   docker cp lwtmp:/build/src-tauri/target/release/llm-wiki ./llm-wiki
#   docker rm lwtmp
# Then scp ./llm-wiki to the server.

FROM almalinux:9

# Build tools + native deps. tauri-runtime declares gtk + webkit2gtk as
# non-optional Linux BUILD dependencies (the webkit2gtk crate targets the 4.0
# ABI = EL9's webkit2gtk3, not the 4.1 ABI that only Fedora/RHEL10 ship), so
# the -devel packages must be present even though the headless binary never
# calls into them at runtime.
RUN dnf groupinstall -y "Development Tools" && \
    dnf install -y dnf-plugins-core protobuf-compiler openssl-devel cmake && \
    dnf config-manager --set-enabled crb && \
    dnf install -y gtk3-devel webkit2gtk3-devel && \
    dnf module install -y nodejs:20/common && \
    dnf clean all

# Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build
COPY . .

# Frontend + headless backend binary
RUN npm ci && \
    npm run build && \
    cargo build --release --manifest-path src-tauri/Cargo.toml \
        --no-default-features --features headless
