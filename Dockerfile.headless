# Build the headless (GTK/WebKit-free) Linux binary for Rocky/RHEL 9.
# Usage:
#   docker build -t llm-wiki-headless -f Dockerfile.headless .
#   docker create --name lwtmp llm-wiki-headless
#   docker cp lwtmp:/build/src-tauri/target/release/llm-wiki ./llm-wiki
#   docker rm lwtmp
# Then scp ./llm-wiki to the server.

FROM almalinux:9

# Build tools + native deps. tauri 2.x declares gtk + webkit2gtk as
# non-optional Linux BUILD dependencies, so their pkg-config probes must
# pass even though the headless binary never calls into them:
#   * gtk3/glib: real EL9 packages; the glib-family .pc files get a shadow
#     copy with Version bumped (EL9 pins 2.68.4, gtk-rs 0.18 wants >= 2.70).
#   * webkit2gtk-4.1 / javascriptcoregtk-4.1 / libsoup-3.0: not shipped by
#     EL9 at all, so we install stub .pc files + empty stub shared objects.
# rustc links with --as-needed, so these unreferenced libs drop out of the
# binary's DT_NEEDED (verify with: ldd target/release/llm-wiki).
RUN dnf install -y dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf groupinstall -y "Development Tools" && \
    dnf install -y unzip openssl-devel cmake gtk3-devel glib2-devel && \
    dnf module install -y nodejs:20/common && \
    dnf clean all

# EL9's protobuf-compiler is 3.14, too old for lance's proto3 files.
# Install a current protoc binary release instead.
RUN curl -sSfL -o /tmp/protoc.zip \
        https://github.com/protocolbuffers/protobuf/releases/download/v25.6/protoc-25.6-linux-x86_64.zip && \
    unzip -o /tmp/protoc.zip -d /usr/local bin/protoc && \
    chmod +x /usr/local/bin/protoc && \
    protoc --version

RUN set -eux; \
    shadow=/opt/pc-shadow; \
    mkdir -p "$shadow"; \
    for pc in /usr/lib64/pkgconfig/{glib,gobject,gio,gmodule,gthread}*.pc; do \
        sed 's/^Version:.*/Version: 2.70.0/' "$pc" > "$shadow/$(basename "$pc")"; \
    done; \
    stub=/opt/webkit-stub; \
    mkdir -p "$stub/lib" "$stub/include"; \
    for lib in webkit2gtk-4.1 javascriptcoregtk-4.1 soup-3.0; do \
        echo 'void __llm_wiki_stub(void){}' | gcc -shared -fPIC -x c - \
            -Wl,-soname,"lib$lib.so.0" -o "$stub/lib/lib$lib.so.0"; \
        ln -sf "lib$lib.so.0" "$stub/lib/lib$lib.so"; \
    done; \
    write_pc() { \
        printf 'prefix=/opt/webkit-stub\nlibdir=${prefix}/lib\nincludedir=${prefix}/include\n\nName: %s\nDescription: stub for headless build\nVersion: %s\nLibs: -L${libdir} -l%s\nCflags: -I${includedir}\n' "$1" "$2" "$3" > "$shadow/$1.pc"; \
    }; \
    write_pc webkit2gtk-4.1 2.46.0 webkit2gtk-4.1; \
    write_pc javascriptcoregtk-4.1 2.46.0 javascriptcoregtk-4.1; \
    write_pc libsoup-3.0 3.6.0 soup-3.0

ENV PKG_CONFIG_PATH=/opt/pc-shadow

# Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build
COPY . .

# Frontend + headless backend binary
RUN npm ci && \
    npm run build && \
    cargo build --release --manifest-path src-tauri/Cargo.toml \
        --no-default-features --features headless
